<?xml version="1.0" encoding="utf-8"?>
<resources>

    <!-- Custom Light Theme: Clean, minimal, modern aesthetic -->
    <style name="Theme.SubTrack" parent="Theme.Material3.Light.NoActionBar">
        <!-- Brand Colors -->
        <item name="colorPrimary">@color/app_primary</item>
        <item name="colorOnPrimary">@color/app_on_primary</item>
        <item name="colorPrimaryContainer">@color/app_primary_container</item>
        <item name="colorOnPrimaryContainer">@color/app_on_primary_container</item>

        <item name="colorSecondary">@color/app_secondary</item>
        <item name="colorOnSecondary">@color/app_on_secondary</item>
        <item name="colorSecondaryContainer">@color/app_secondary_container</item>
        <item name="colorOnSecondaryContainer">@color/app_on_secondary_container</item>

        <item name="colorError">@color/app_error</item>
        <item name="colorOnError">@color/app_on_primary</item>
        <item name="colorErrorContainer">@color/app_error_container</item>

        <!-- Background & Surface (Pure Light) -->
        <item name="android:windowBackground">@color/app_background</item>
        <item name="android:colorBackground">@color/app_background</item>
        <item name="colorOnBackground">@color/app_text_primary</item>

        <item name="colorSurface">@color/app_surface</item>
        <item name="colorOnSurface">@color/app_text_primary</item>
        <item name="colorSurfaceVariant">@color/app_surface_variant</item>
        <item name="colorOnSurfaceVariant">@color/app_text_secondary</item>
        <item name="colorOutline">@color/app_border</item>

        <!-- System Bars (Light with dark icons) -->
        <item name="android:statusBarColor">@color/app_background</item>
        <item name="android:windowLightStatusBar">true</item>
        <item name="android:navigationBarColor">@color/app_surface</item>
        <item name="android:windowLightNavigationBar">true</item>

        <!-- Default Component Styles -->
        <item name="materialCardViewStyle">@style/Widget.SubTrack.Card</item>
        <item name="materialButtonStyle">@style/Widget.SubTrack.Button</item>
        <item name="bottomNavigationStyle">@style/Widget.SubTrack.BottomNavigationView</item>
    </style>

    <!-- Custom Card Style: Pure white, subtle stroke border, soft 16dp rounded corners -->
    <style name="Widget.SubTrack.Card" parent="Widget.Material3.CardView.Elevated">
        <item name="cardBackgroundColor">@color/app_card_bg</item>
        <item name="cardCornerRadius">16dp</item>
        <item name="cardElevation">2dp</item>
        <item name="strokeWidth">1dp</item>
        <item name="strokeColor">@color/app_border</item>
        <item name="android:stateListAnimator">@null</item>
    </style>

    <!-- Custom Button: Modern rounded pill button with subtle elevation and bold text -->
    <style name="Widget.SubTrack.Button" parent="Widget.Material3.Button">
        <item name="cornerRadius">14dp</item>
        <item name="android:textAllCaps">false</item>
        <item name="android:fontFamily">sans-serif-medium</item>
        <item name="android:letterSpacing">0.01</item>
        <item name="android:insetTop">0dp</item>
        <item name="android:insetBottom">0dp</item>
        <item name="elevation">0dp</item>
        <item name="backgroundTint">@color/app_primary</item>
        <item name="android:textColor">@color/app_on_primary</item>
    </style>

    <!-- Custom Secondary / Outlined Button -->
    <style name="Widget.SubTrack.Button.Outlined" parent="Widget.Material3.Button.OutlinedButton">
        <item name="cornerRadius">14dp</item>
        <item name="android:textAllCaps">false</item>
        <item name="android:fontFamily">sans-serif-medium</item>
        <item name="strokeColor">@color/app_border</item>
        <item name="strokeWidth">1.5dp</item>
        <item name="android:textColor">@color/app_text_primary</item>
    </style>

    <!-- Custom Bottom Navigation: Clean white background, no top shadow divider, subtle active indicator -->
    <style name="Widget.SubTrack.BottomNavigationView" parent="Widget.Material3.BottomNavigationView">
        <item name="backgroundTint">@color/app_surface</item>
        <item name="itemIconTint">@color/selector_nav_item</item>
        <item name="itemTextColor">@color/selector_nav_item</item>
        <item name="itemActiveIndicatorStyle">@style/Widget.SubTrack.ActiveIndicator</item>
        <item name="elevation">0dp</item>
    </style>

    <style name="Widget.SubTrack.ActiveIndicator" parent="Widget.Material3.BottomNavigationView.ActiveIndicator">
        <item name="android:color">@color/app_primary_container</item>
        <item name="android:width">48dp</item>
        <item name="android:height">32dp</item>
    </style>

    <!-- Custom Outlined Input Layout -->
    <style name="Widget.SubTrack.TextInputLayout" parent="Widget.Material3.TextInputLayout.OutlinedBox">
        <item name="boxCornerRadiusTopStart">14dp</item>
        <item name="boxCornerRadiusTopEnd">14dp</item>
        <item name="boxCornerRadiusBottomStart">14dp</item>
        <item name="boxCornerRadiusBottomEnd">14dp</item>
        <item name="boxStrokeColor">@color/selector_box_stroke</item>
        <item name="boxBackgroundColor">@color/app_surface</item>
        <item name="hintTextColor">@color/app_primary</item>
        <item name="android:textColorHint">@color/app_text_muted</item>
    </style>

</resources>