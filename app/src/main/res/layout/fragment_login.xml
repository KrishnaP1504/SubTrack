<?xml version="1.0" encoding="utf-8"?>
<androidx.coordinatorlayout.widget.CoordinatorLayout
    xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/app_background">

    <!-- Top app bar -->
    <com.google.android.material.appbar.AppBarLayout
        android:id="@+id/appBarLayout"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:background="@color/app_background"
        app:elevation="0dp">

        <com.google.android.material.appbar.MaterialToolbar
            android:id="@+id/toolbar"
            android:layout_width="match_parent"
            android:layout_height="?attr/actionBarSize"
            app:navigationIcon="@drawable/ic_back"
            app:navigationIconTint="@color/app_text_primary"
            app:title="@string/phone_login_title"
            app:titleTextColor="@color/app_text_primary"
            app:titleTextAppearance="@style/TextAppearance.Material3.TitleMedium" />

    </com.google.android.material.appbar.AppBarLayout>

    <androidx.core.widget.NestedScrollView
        android:id="@+id/nestedScrollView"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:fillViewport="true"
        app:layout_behavior="@string/appbar_scrolling_view_behavior">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:paddingStart="24dp"
            android:paddingEnd="24dp"
            android:paddingTop="16dp"
            android:paddingBottom="32dp">

            <!-- App Logo Badge -->
            <ImageView
                android:layout_width="48dp"
                android:layout_height="48dp"
                android:src="@drawable/ic_welcome_logo"
                app:tint="@color/app_primary"
                android:contentDescription="@string/app_name"
                android:layout_marginBottom="16dp" />

            <!-- Title & Subtitle -->
            <TextView
                android:id="@+id/tvHeaderTitle"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="@string/phone_login_title"
                android:textColor="@color/app_text_primary"
                android:textSize="26sp"
                android:fontFamily="sans-serif-medium"
                android:textStyle="bold"
                android:letterSpacing="-0.02" />

            <TextView
                android:id="@+id/tvHeaderSubtitle"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="@string/phone_login_subtitle"
                android:textColor="@color/app_text_secondary"
                android:textSize="14sp"
                android:lineSpacingExtra="3dp"
                android:layout_marginTop="8dp"
                android:layout_marginBottom="28dp" />

            <!-- ── STEP 1: Phone Number Input ── -->
            <LinearLayout
                android:id="@+id/layoutPhoneInput"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="vertical"
                android:visibility="visible">

                <!-- Phone number field with country code prefix -->
                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="horizontal"
                    android:gravity="center_vertical">

                    <!-- Country Code Box -->
                    <com.google.android.material.textfield.TextInputLayout
                        android:id="@+id/tilCountryCode"
                        android:layout_width="88dp"
                        android:layout_height="wrap_content"
                        android:layout_marginEnd="10dp"
                        style="@style/Widget.SubTrack.TextInputLayout">

                        <com.google.android.material.textfield.TextInputEditText
                            android:id="@+id/etCountryCode"
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:text="+91"
                            android:textColor="@color/app_text_primary"
                            android:gravity="center"
                            android:inputType="phone"
                            android:maxLength="4" />
                    </com.google.android.material.textfield.TextInputLayout>

                    <!-- Mobile Number Box -->
                    <com.google.android.material.textfield.TextInputLayout
                        android:id="@+id/tilPhone"
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:layout_weight="1"
                        android:hint="@string/phone_hint"
                        style="@style/Widget.SubTrack.TextInputLayout">

                        <com.google.android.material.textfield.TextInputEditText
                            android:id="@+id/etPhone"
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:textColor="@color/app_text_primary"
                            android:inputType="phone"
                            android:maxLength="10"
                            android:imeOptions="actionDone"
                            android:maxLines="1" />
                    </com.google.android.material.textfield.TextInputLayout>
                </LinearLayout>

                <!-- Send OTP Button -->
                <FrameLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="24dp">

                    <com.google.android.material.button.MaterialButton
                        android:id="@+id/btnSendOtp"
                        android:layout_width="match_parent"
                        android:layout_height="56dp"
                        android:text="@string/get_otp"
                        style="@style/Widget.SubTrack.Button" />

                    <ProgressBar
                        android:id="@+id/pbSendOtp"
                        android:layout_width="28dp"
                        android:layout_height="28dp"
                        android:layout_gravity="center"
                        android:indeterminateTint="@color/app_on_primary"
                        android:visibility="gone" />
                </FrameLayout>

            </LinearLayout>

            <!-- ── STEP 2: OTP Verification ── -->
            <LinearLayout
                android:id="@+id/layoutOtpInput"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="vertical"
                android:visibility="gone">

                <!-- Sent to info + edit button -->
                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="horizontal"
                    android:gravity="center_vertical"
                    android:layout_marginBottom="16dp">

                    <TextView
                        android:id="@+id/tvOtpSubtitle"
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:layout_weight="1"
                        android:text="@string/otp_title"
                        android:textColor="@color/app_text_secondary"
                        android:textSize="14sp" />

                    <TextView
                        android:id="@+id/btnChangePhone"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="@string/change_phone_number"
                        android:textColor="@color/app_primary"
                        android:textStyle="bold"
                        android:textSize="13sp"
                        android:padding="6dp" />
                </LinearLayout>

                <!-- 6-digit OTP Input -->
                <com.google.android.material.textfield.TextInputLayout
                    android:id="@+id/tilOtp"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:hint="@string/otp_hint"
                    style="@style/Widget.SubTrack.TextInputLayout">

                    <com.google.android.material.textfield.TextInputEditText
                        android:id="@+id/etOtp"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:textColor="@color/app_text_primary"
                        android:inputType="number"
                        android:maxLength="6"
                        android:gravity="center"
                        android:letterSpacing="0.4"
                        android:textSize="20sp"
                        android:textStyle="bold"
                        android:imeOptions="actionDone"
                        android:maxLines="1" />
                </com.google.android.material.textfield.TextInputLayout>

                <!-- Verify Button -->
                <FrameLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="20dp">

                    <com.google.android.material.button.MaterialButton
                        android:id="@+id/btnVerifyOtp"
                        android:layout_width="match_parent"
                        android:layout_height="56dp"
                        android:text="@string/verify_and_continue"
                        style="@style/Widget.SubTrack.Button" />

                    <ProgressBar
                        android:id="@+id/pbVerifyOtp"
                        android:layout_width="28dp"
                        android:layout_height="28dp"
                        android:layout_gravity="center"
                        android:indeterminateTint="@color/app_on_primary"
                        android:visibility="gone" />
                </FrameLayout>

                <!-- Resend OTP button / timer -->
                <TextView
                    android:id="@+id/tvResendOtp"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_gravity="center_horizontal"
                    android:layout_marginTop="20dp"
                    android:text="@string/resend_otp"
                    android:textColor="@color/app_text_muted"
                    android:textSize="14sp"
                    android:fontFamily="sans-serif-medium"
                    android:padding="8dp" />

            </LinearLayout>

        </LinearLayout>
    </androidx.core.widget.NestedScrollView>

</androidx.coordinatorlayout.widget.CoordinatorLayout>
