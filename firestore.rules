rules_version = '2';

service cloud.firestore {
  match /databases/{database}/documents {
    // User profile document: strictly isolated to the authenticated user
    match /users/{userId} {
      allow read, write: if request.auth != null && request.auth.uid == userId;

      // User subscriptions subcollection: strictly isolated to the authenticated user
      match /subscriptions/{subscriptionId} {
        allow read, write: if request.auth != null && request.auth.uid == userId;
      }
    }

    // Default deny: prevent unauthorized access to any other collections
    match /{document=**} {
      allow read, write: if false;
    }
  }
}
